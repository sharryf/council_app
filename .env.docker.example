# Copy this file to .env on the server (cp .env.docker.example .env) and fill
# in the blanks. Never commit the real .env — it is git-ignored.
#
# Generate the secrets on the server with:
#   APP_KEY           echo "base64:$(openssl rand -base64 32)"
#   DB / root passwords   openssl rand -hex 24
# (hex passwords avoid characters that break .env files.)
# Moving existing data? Reuse the APP_KEY from your local .env instead.

APP_NAME="Council App"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://council.example.com

# Your domain -> automatic HTTPS (its DNS must already point at this server,
# with ports 80 and 443 open). To test over plain HTTP by IP address instead,
# set SERVER_NAME=:80, APP_URL=http://YOUR_SERVER_IP and
# SESSION_SECURE_COOKIE=false — logins fail over HTTP otherwise.
SERVER_NAME=council.example.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# The database container is called "db" — leave DB_HOST as is.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=council_app
DB_USERNAME=council_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
